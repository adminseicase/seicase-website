{
  "name": "seicase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "next analyze",
    "images:generate": "node scripts/generate-images.ts",
    "db:seed:generate": "node scripts/generate-seed.ts",
    "db:push": "supabase db push",
    "db:seed": "supabase db execute --file supabase/seed.sql",
    "db:types": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts",
    "email:preview": "email dev --dir emails"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  }
}
