# =============================================================================
# seicase — environment variables
# Copy this file to `.env.local` (local) and add the same values in
# Vercel → Project → Settings → Environment Variables (production).
#
# Variables starting with NEXT_PUBLIC_ are visible in the browser.
# Everything else is a SECRET and must never be shared or committed.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Your public address, no trailing slash. Used for SEO, emails and invoices.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Leave these empty to run the storefront in read-only demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Full database access — server only. Needed for checkout, webhooks,
# contact form, newsletter, analytics and the admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard → Account & Settings → API Keys) --------------------
# Use rzp_test_… keys while testing, rzp_live_… after KYC approval.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Webhooks → the secret you typed when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=a-long-random-string

# --- Email (Resend → API Keys) ------------------------------------------------
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must use a domain you verified in Resend (see docs/DEPLOYMENT.md).
EMAIL_FROM=seicase <hello@seicase.com>
# Optional: where new-order / contact / low-stock emails go
# (otherwise Admin → Settings → Notifications is used).
ADMIN_NOTIFICATION_EMAIL=

# --- Security -----------------------------------------------------------------
# Random strings (e.g. run: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
# CRON_SECRET protects /api/cron/daily (Vercel sends it automatically).
CRON_SECRET=change-me
# REVALIDATE_SECRET protects POST /api/revalidate (optional external webhooks).
REVALIDATE_SECRET=change-me
# Salt used to hash visitor IP addresses for rate limiting (never stored raw).
IP_HASH_SALT=change-me

# --- Optional: Cloudflare Turnstile spam protection on the contact form ------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: extra analytics (first-party analytics always run) ------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Set to 1 after enabling Web Analytics in your Vercel project.
NEXT_PUBLIC_VERCEL_ANALYTICS=
